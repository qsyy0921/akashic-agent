        "type": "object",
        "properties": {
          "location": {"type": "string", "description": "城市或地点"},
          "date": {"type": "string", "description": "查询日期"}
        },
        "required": ["location"]
      },
      "operation_id": "weather.query",
      "summary": "查询城市天气预报、气温、降雨和空气质量。",
      "parameter_terms": ["城市", "地点", "日期", "温度", "降雨", "空气质量"],
      "examples": ["明天杭州会下雨吗", "北京今天空气质量怎么样", "查上海明天气温"],
      "output_kinds": ["data", "text"],
      "source_type": "plugin",
      "source_name": "eval.weather",
      "risk": "read-only",
      "always_on": false
    },
